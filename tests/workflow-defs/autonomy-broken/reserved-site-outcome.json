{
  "$comment": "Broken autonomy fixture (R3): row resume_or_skew gives reserved site resume_on_start an outcome part. Breaks ONLY R3.",
  "version": 1,
  "levels": [
    "high",
    "balanced",
    "low"
  ],
  "default_level": "high",
  "hard_stops": [
    {
      "hard_stop": "trunk_commit_push",
      "when": "A commit or push would land directly on the trunk branch."
    }
  ],
  "rows": [
    {
      "kind": "plan_acceptance",
      "high": "auto",
      "balanced": "auto",
      "low": "surface",
      "resolved_at": [
        "plan.single",
        "plan.multi"
      ],
      "when": "Cerebrate returns a plan with no open questions."
    },
    {
      "kind": "remediation_plan_acceptance",
      "high": "surface",
      "balanced": "surface",
      "low": "surface",
      "resolved_at": [
        "review_remediation_plan.single",
        "review_remediation_plan.multi",
        "review_remediation_plan_postpr.single",
        "review_remediation_plan_postpr.multi"
      ],
      "when": "A planner returns a remediation plan for a root cluster."
    },
    {
      "kind": "resume_or_skew",
      "high": "surface",
      "balanced": "surface",
      "low": "surface",
      "when": "Broken-fixture row.",
      "resolved_at": [
        "resume_on_start.go"
      ]
    }
  ]
}
