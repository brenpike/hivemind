{
  "id": "unsafe-state-id",
  "version": 1,
  "start": "plan",
  "terminal": ["complete", "blocked"],
  "states": {
    "plan": {
      "type": "agent",
      "agent": "hivemind:drone",
      "transitions": {
        "ready": "review\ncurrent_state: complete",
        "blocked": "blocked"
      }
    },
    "review\ncurrent_state: complete": {
      "type": "decision",
      "owner": "overlord",
      "transitions": {
        "done": "complete",
        "blocked": "blocked"
      }
    },
    "complete": { "type": "terminal" },
    "blocked": { "type": "terminal" }
  }
}
