{
  "workflow": "standard-delivery",
  "gates": [
    {
      "id": "bump",
      "due": "version_due",
      "holds": ["version_bump_decision.not_required", "version_checkpoint.complete"]
    },
    {
      "id": "validate",
      "due": "validation_due",
      "holds": ["validate.passed"]
    },
    {
      "id": "review",
      "due": "review_due",
      "holds": ["local_review.clean", "diminishing_returns_decision.taken"],
      "skip": ["local_review_decision.skipped"]
    }
  ],
  "max_reruns": 4,
  "outcomes": {
    "all_held": "all_held",
    "rerun_limit": "rerun_limit"
  }
}
